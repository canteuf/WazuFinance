# Projet Supabase — Settings > API dans le dashboard.
# Ces deux valeurs sont publiques et finissent en clair dans le bundle : la
# sécurité repose sur les policies RLS. Ne jamais mettre la clé service_role ici.
EXPO_PUBLIC_SUPABASE_URL=https://votre-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Suivi des plantages (facultatif) — sentry.io > projet > Settings > Client Keys (DSN).
# Public par conception : il permet d'envoyer des erreurs, pas de les lire. Vide = suivi éteint.
EXPO_PUBLIC_SENTRY_DSN=
